{
  "expo": {
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/adaptive-icon.png"
      },
      "package": "com.pakmultilinks.aitransform"
    },
    "experiments": {
      "typedRoutes": false
    },
    "icon": "./assets/icon.png",
    "ios": {
      "bundleIdentifier": "com.pakmultilinks.aitransform",
      "supportsTablet": true
    },
    "name": "aiTransform",
    "newArchEnabled": true,
    "orientation": "portrait",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-status-bar"
    ],
    "scheme": "aitransform",
    "slug": "aitransform-mobile-app",
    "userInterfaceStyle": "light",
    "version": "1.0.0",
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png",
      "output": "static"
    }
  }
}
